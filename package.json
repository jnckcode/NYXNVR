{
  "name": "antigravity-nvr",
  "version": "1.1.0",
  "description": "Node.js Lightweight Network Video Recorder with Single Ingestion, Dynamic Two-Stage AI, and Zero-Config UX",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/public', 'dist/public', {recursive: true})\"",
    "start": "ts-node src/index.ts",
    "prod": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "ts-node src/test.ts",
    "service:install": "node scripts/service-manager.js install",
    "service:uninstall": "node scripts/service-manager.js uninstall",
    "service:start": "node scripts/service-manager.js start",
    "service:stop": "node scripts/service-manager.js stop",
    "service:status": "node scripts/service-manager.js status"
  },
  "keywords": [
    "nvr",
    "cctv",
    "rtsp",
    "ffmpeg",
    "fmp4",
    "mse",
    "onnx",
    "yolo",
    "fastify",
    "sqlite",
    "iot",
    "arm64"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.20.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^22.13.5",
    "@types/ws": "^8.5.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "onnxruntime-node@1.29.0": true
  }
}
